{
  "name": "labnodes",
  "version": "1.0.0",
  "description": "Lab Nodes/React",
  "homepage": "https://github.com/ricardo2509/LabNodes#readme",
  "bugs": {
    "url": "https://github.com/ricardo2509/LabNodes/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ricardo2509/LabNodes.git"
  },
  "license": "ISC",
  "author": "Ricardo TP",
  "main": "index.js",
  "scripts": {
    "dev": "npm run services:up && next dev",
    "services:up": "bash -c 'docker compose -f infra/compose.yaml up -d'",
    "test": "jest",
    "test-watch": "jest --watchAll --no-cache --no-watchman",
    "migration:create": "node-pg-migrate --migrations-dir infra/migrations create",
    "migration:up": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development up",
    "migration:down": "node-pg-migrate --migrations-dir infra/migrations --envPath .env.development down"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "next": "^16.2.1",
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "swr": "^2.4.0"
  },
  "devDependencies": {
    "jest": "^29.6.2"
  }
}
